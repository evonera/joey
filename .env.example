# Database
# DATABASE_PROVIDER selects the pooler: 'neon' (serverless) or 'postgres'
# (standard postgres-js pool for self-hosting). Leave unset to auto-detect
# when the DATABASE_URL contains "neon.tech".
DATABASE_PROVIDER="postgres"
DATABASE_URL="postgres://postgres:password@localhost:5432/joey"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# BetterAuth
BETTER_AUTH_SECRET="super-secret-key-change-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth (BetterAuth)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LLM Fallbacks (for BYOK platform-level features)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Encryption Key (for storing Zernio/LLM keys AES-256-GCM)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Zernio Webhooks
ZERNIO_WEBHOOK_SECRET=""
NEXT_PUBLIC_ZERNIO_WEBHOOK_URL=""

# Composio (App Integrations for News, Search, Email, Calendar, etc.)
# Get your API key at https://composio.dev
COMPOSIO_API_KEY=""

# Email (Resend) - required for notification/engagement emails
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@joey.app"

# Dodo Payments (Subscription & Billing)
# https://dodopayments.com
DODO_PAYMENTS_API_KEY=""
# "test_mode" | "live_mode"
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_PAYMENTS_WEBHOOK_SECRET=""
# Product ID for the "Pro" plan used by the checkout plugin
NEXT_PUBLIC_DODO_PRO_PRODUCT_ID="pdt_pro"

# Cloudflare R2 (Asset Storage)
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="joey-assets"

# --- Flow integrations (all optional, BYOK stored per-workspace in Settings) ---
# Server-level fallbacks:
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
SUPADATA_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
APIFY_TOKEN=
