# =============================================================================
# Joey Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Required variables are marked with [Required].

# -----------------------------------------------------------------------------
# Core Application & Auth [Required]
# -----------------------------------------------------------------------------
# These must be the same origin (scheme, hostname and port), without a path.
# Changing JOEY_PORT also requires changing BOTH URLs. NEXT_PUBLIC_* values
# are inlined during the build, so rebuild the image after changing them.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="super-secret-key-change-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Encryption key for storing API keys (AES-256-GCM)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# Database [Required]
# -----------------------------------------------------------------------------
# DATABASE_PROVIDER selects the driver: 'neon' (transaction-capable WebSocket
# pool) or 'postgres' (postgres-js pool for self-hosting). neon-http is not
# supported because the application requires database transactions.
# Leave unset to auto-detect when DATABASE_URL contains "neon.tech".
DATABASE_PROVIDER="postgres"
DATABASE_URL="postgres://postgres:password@localhost:5432/joey"

# Docker Compose PostgreSQL service. Generate a URL-safe password with:
# openssl rand -hex 24
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="joey"
# Compose uses this internal URL for the app and migrator. Percent-encode the
# username/password components if they contain URL-reserved characters.
JOEY_DATABASE_URL="postgresql://postgres:password@db:5432/joey"
JOEY_PORT="3000"
POSTGRES_PORT="5432"
# Eve stays on loopback inside the web host/container. Its port is also inlined
# into Next's proxy routes: use the same value for build and runtime, then rebuild.
EVE_NEXT_PRODUCTION_PORT="4274"

# Temporary compatibility for credentials created before tenant-bound v2.
# Set false after `npm run db:migrate-secrets` completes and is verified.
ALLOW_LEGACY_UNBOUND_SECRETS="true"

# -----------------------------------------------------------------------------
# Asset Storage - Cloudflare R2 [Required for Media & Theme Studio]
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="joey-assets"

# -----------------------------------------------------------------------------
# Cron Security [Required for scheduled work on any host]
# -----------------------------------------------------------------------------
# Protects /api/cron and the server-only Scout Workflow handoff.
# Generate with: openssl rand -base64 32
# Vercel automatically attaches this header when CRON_SECRET is set.
CRON_SECRET=""

# -----------------------------------------------------------------------------
# OAuth Providers (Optional - for social login)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Publishing & Social Integration
# -----------------------------------------------------------------------------
ZERNIO_API_KEY=""
ZERNIO_WEBHOOK_SECRET=""
NEXT_PUBLIC_ZERNIO_WEBHOOK_URL=""

# -----------------------------------------------------------------------------
# LLM Fallbacks (Optional - for BYOK platform-level features)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
SUPADATA_API_KEY=""

# Scout collection boundary (optional; Apify remains the default).
# Protected Cloud transport is server-only and pinned to this exact endpoint.
# Set all three together; never use NEXT_PUBLIC_ names or a shared workspace key.
SCOUT_MODAL_ENDPOINT=""
SCOUT_MODAL_KEY=""
SCOUT_MODAL_SECRET=""
# apify: workspace BYOK in Settings, or operator APIFY_TOKEN fallback.
# custom: HTTPS protocol documented in docs/open-core.md; requires a separate
# encrypted "Custom Scout provider" key in EACH workspace's Settings.
# mock: development/test only, never permitted in production.
SCOUT_DATA_PROVIDER="apify"
SCOUT_PROVIDER_ENDPOINT=""
APIFY_TOKEN=""
ENABLE_MOCK_SCOUTS="false"

# -----------------------------------------------------------------------------
# Email - Resend (Optional - for notification/engagement emails)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@joey.app"

# -----------------------------------------------------------------------------
# Dodo Payments (Optional - for subscription & billing)
# https://dodopayments.com
# -----------------------------------------------------------------------------
DODO_PAYMENTS_API_KEY=""
# "test_mode" | "live_mode"
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_PAYMENTS_WEBHOOK_SECRET=""
NEXT_PUBLIC_DODO_CREATOR_PRODUCT_ID="pdt_creator"
NEXT_PUBLIC_DODO_PRO_PRODUCT_ID="pdt_pro"
NEXT_PUBLIC_DODO_AGENCY_PRODUCT_ID="pdt_agency"
DODO_CREATOR_LEGACY_PRODUCT_IDS=""
DODO_PRO_LEGACY_PRODUCT_IDS=""
DODO_AGENCY_LEGACY_PRODUCT_IDS=""

# Sentry error and performance monitoring. Docker build args include only the
# public browser DSN/environment; never pass SENTRY_AUTH_TOKEN as a build arg.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Modal's joey-media-secrets uses the same DSN under the server-only name below.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE=""

# -----------------------------------------------------------------------------
# Exa AI Search (Optional - for Web Research, News & Authentic Photography)
# https://dashboard.exa.ai
# -----------------------------------------------------------------------------
EXA_API_KEY=""

# -----------------------------------------------------------------------------
# Composio (Optional - for app integrations: News, Search, Email, Calendar)
# https://composio.dev
# -----------------------------------------------------------------------------
COMPOSIO_API_KEY=""

# -----------------------------------------------------------------------------
# TypeSafe Jev (Optional - cautious defaults to avoid credit compound)
# Only Scout pre-gate + DM fallback are enabled by default.
# Clustering defaults to OFF. Set TYPESAFE_API_KEY server-side or use tenant BYOK.
# -----------------------------------------------------------------------------
TYPESAFE_API_KEY=""
TYPESAFE_SCOUT_GATE="true"
TYPESAFE_DM_FALLBACK="true"
THEME_STUDIO_CLUSTERING_MODE="off"
JEV_DAILY_CAP="500"
JEV_MONTHLY_CAP="10000"

# -----------------------------------------------------------------------------
# WebMCP - Chrome/Edge Origin Trial (Optional)
# Register at https://developer.chrome.com/origintrials
# Emitted as <meta http-equiv="origin-trial"> — public by design.
# Set before building; Compose passes this public value to the image builder.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=""

# -----------------------------------------------------------------------------
# Real-Time Collaboration & Presence - Liveblocks (Optional)
# https://liveblocks.io
# Enables live presence avatars, co-review, and threaded draft discussions.
# If left empty, Joey operates seamlessly in standalone/solo mode.
# -----------------------------------------------------------------------------
LIVEBLOCKS_SECRET_KEY=""

# -----------------------------------------------------------------------------
# Build Configuration (Optional - rarely needed)
# -----------------------------------------------------------------------------
# NEXT_OUTPUT - Leave unset for standalone (Docker/Vercel/Netlify).
#               Set to "export" only for static builds (Tauri desktop client).
# NEXT_OUTPUT=""
#
# ANALYZE - Set to "true" to generate bundle analysis reports.
# ANALYZE=""
# Agency daily draft automation is opt-in after deployment acceptance.
AGENCY_AUTOMATION_ENABLED=false
